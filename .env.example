# Set these server-only variables in Vercel, never with a VITE_ prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: otherwise derived server-side from the Redis credential.
# Generate a random value with: openssl rand -hex 32
LIKE_COOKIE_SECRET=
# Use separate namespaces for preview and production if desired.
LIKES_NAMESPACE=bornfor:website:v1

# Vercel Marketplace may supply KV_REST_API_URL / KV_REST_API_TOKEN instead.
